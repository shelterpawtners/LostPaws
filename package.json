{
  "name": "lostpaws",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude=\"e2e/**\"",
    "test:e2e": "playwright test",
    "test:e2e:hosted": "playwright test e2e/hosted-qa-smoke.spec.ts e2e/hosted-qa-marketplace-golden.spec.ts e2e/marketplace-premium.spec.ts",
    "test:e2e:public": "playwright test e2e/rave-shelter-mission.spec.ts e2e/issue-125-rave-lostpaws-mobile.spec.ts e2e/track3-learn-hero-vendor.spec.ts e2e/site-hygiene.spec.ts e2e/seven-star-shelters.spec.ts e2e/store.spec.ts",
    "test:e2e:admin-qa": "playwright test e2e/admin-qa-mode.spec.ts",
    "lint": "prettier --check src docs README.md AGENTS.md CLAUDE.md '.github/**/*.{md,yml,yaml}'",
    "lint:shell": "bash -n scripts/*.sh",
    "typecheck": "tsc -b --pretty false",
    "release-state:check": "node scripts/release-state.mjs check",
    "release-state:generate": "node scripts/release-state.mjs generate",
    "check": "npm run lint && npm run lint:shell && npm run typecheck && npm run release-state:check && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "1.41.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "js-yaml": "^5.4.2",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
